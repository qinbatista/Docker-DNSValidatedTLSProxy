# Copy to .env on the Raspberry Pi. Keep this file private.
TLS_HOSTNAME=la.qyp.life
PUBLIC_HTTPS_PORT=8443
PUBLIC_BIND_ADDRESS=0.0.0.0
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=replace-with-route53-dns-change-access
AWS_SECRET_ACCESS_KEY=replace-with-route53-dns-change-secret
# AWS_SESSION_TOKEN=optional-temporary-credential-token
UPSTREAM_NETWORK=video-url-download_default
UPSTREAM_CONTAINER_NAME=video-url-download
UPSTREAM_PORT=8787
PROXY_IMAGE=ghcr.io/qinbatista/la-dns-tls-proxy:latest
