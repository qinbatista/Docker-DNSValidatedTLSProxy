# DNS-01 validation avoids port 80 and this proxy deliberately listens on 8443,
# leaving the host's existing port 443 and containers untouched.
{
	auto_https disable_redirects
}

# These two hostnames avoid stale negative AAAA caches on previously configured
# clients while keeping the public downloader endpoint on port 8443. Avoid a
# wildcard certificate, which creates concurrent DNS-01 TXT challenges.
https://la.qyp.life:8443, https://shortcut.la.qyp.life:8443 {
	tls {
		dns route53
	}

	@video host la.qyp.life shortcut.la.qyp.life
	handle @video {
		reverse_proxy {$UPSTREAM_CONTAINER_NAME}:{$UPSTREAM_PORT}
	}

	respond "Not found" 404
}
