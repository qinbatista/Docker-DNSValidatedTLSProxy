# DNS-01 validation avoids port 80 and this proxy deliberately listens on 8443,
# leaving the host's existing port 443 and containers untouched.
{
	auto_https disable_redirects
}

# This endpoint needs a certificate for the single public downloader hostname.
# Avoid issuing an unnecessary wildcard certificate, which creates concurrent
# DNS-01 TXT challenges for the same record name.
https://la.qyp.life:8443 {
	tls {
		dns route53
	}

	@video host {$TLS_HOSTNAME}
	handle @video {
		reverse_proxy {$UPSTREAM_CONTAINER_NAME}:{$UPSTREAM_PORT}
	}

	respond "Not found" 404
}
